{
  "schemaVersion": "3.4",
  "scoringMode": "track-aware-v3",
  "scoreScale": {
    "minimum": 0,
    "maximum": 100
  },
  "tracks": {
    "HOT_EVENT": {
      "label": "热点事件",
      "weights": {
        "attentionMomentum": 25,
        "sourceVelocity": 20,
        "freshness": 15,
        "sustainedAttention": 10,
        "eventImpact": 15,
        "editorialPotential": 10,
        "enterpriseBridge": 5
      }
    },
    "PUBLIC_VOICE": {
      "label": "人物观点",
      "weights": {
        "speakerInfluence": 20,
        "sourceDirectness": 15,
        "viewpointCompleteness": 20,
        "viewpointNovelty": 15,
        "audienceResonance": 15,
        "strategicBridge": 10,
        "timeliness": 5
      }
    },
    "ENTERPRISE_AI": {
      "label": "企业AI与产业AI",
      "weights": {
        "enterpriseTransformation": 20,
        "agenticOSRelevance": 20,
        "customerProblemRelevance": 15,
        "businessOutcomeValue": 15,
        "caseReplicability": 10,
        "jovaStrategicBridge": 10,
        "editorialPotential": 10
      }
    }
  },
  "thresholds": {
    "priority": 80,
    "recommended": 70,
    "watch": 60,
    "minimumFormalCandidate": 55
  },
  "intersectionBonus": {
    "secondaryTrackThreshold": 65,
    "perAdditionalTrack": 2.5,
    "maximum": 5
  },
  "penalties": {
    "technicalNarrownessWithoutBridge": 10,
    "missingPublishedAt": 3,
    "highRiskExpression": 4
  },
  "timeWindowsHours": [
    24,
    72,
    168
  ],
  "dailyCandidateMinimum": 5,
  "dailyCandidateMaximum": 8,
  "seedSourceMinimum": 1,
  "seedSourceMaximum": 4,
  "diversity": {
    "minimumTrackCoverage": 2,
    "maximumPerTrack": 5,
    "maximumPerTheme": 4
  },
  "preferencePolicy": {
    "mode": "bounded-user-calibration",
    "minimumLabeledExamplesPerTrack": 5,
    "maximumTrackAdjustment": 5,
    "trackAdjustments": {
      "HOT_EVENT": 0,
      "PUBLIC_VOICE": 0,
      "ENTERPRISE_AI": 0
    },
    "automaticWeightMutation": false
  },
