OTEL_SERVICE_NAME=agt-rsn-004-api
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_METRIC_EXPORT_INTERVAL_MS=30000
ALLOWED_OUTBOUND_HOSTS=
HANDOFF_BASE_URL=
HANDOFF_API_KEY=
AGENT_PROTOCOL_HMAC_SECRET=
