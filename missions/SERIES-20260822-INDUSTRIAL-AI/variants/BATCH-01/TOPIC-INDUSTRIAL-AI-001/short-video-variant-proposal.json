  "copy": {
    "titleCandidates": [
      "AI工具这么多，企业为什么还需要产业AI？",
      "企业缺的不是AI工具，是能进业务的AI",
      "艾氪智能为什么选择产业深处？"
    ],
    "hooks": [
      "今天的企业不缺AI工具，真正难的是：AI能不能把一张报价推进到可执行的结果。",
      "会写邮件、会做图片的AI很多，但它知道库存、价格和履约责任之间是什么关系吗？",
      "如果AI只会给答案，却进不了真实任务，它给企业带来的价值就很有限。"
    ],
    "scenes": [
      {
        "time": "0–5秒",
        "narration": "今天的企业不缺AI工具，真正难的是：AI能不能把一张报价推进到可执行的结果。",
        "subtitle": "企业不缺AI工具",
        "visual": "负责人面对多种AI工具界面，镜头切到一张待确认的询报价任务。",
        "claimIds": []
      },
      {
        "time": "5–22秒",
        "narration": "到了真实业务里，报价会牵动库存和交付，采购要看供应商和价格条件，财务判断还离不开订单、应收应付和履约状态。AI面对的已经不只是文字。",
        "subtitle": "真实任务彼此相连",
        "visual": "商品、客户、供应商、价格、合同、交付、结算节点逐一连成关系图。",
        "claimIds": [
          "EXT-001-02"
        ]
      },
      {
        "time": "22–45秒",
        "narration": "所以艾氪智能聚焦企业AI和产业AI。我们关心的起点，是具体业务对象和真实任务：信息对不对，权限清不清，责任能不能归属，过程能不能追溯。",
        "subtitle": "从业务对象和真实任务出发",
        "visual": "任务卡依次出现信息、权限、责任、追溯四个检查点。",
        "claimIds": [
          "claim:ENT-001",
          "claim:ENT-002",
          "claim:ENT-003"
        ]
      },
      {
        "time": "45–70秒",
        "narration": "这背后也需要长期的产业建模。艾氪智能历时6年，基于300多个行业、30万家注册企业、3000多家龙头企业和600亿产业交易积累，创建了JovaAI ICB，并形成3000+功能元。注意：这些数字各有明确口径，不能等同于付费客户、营收或智能体数量。",
        "subtitle": "6年产业积累｜数据口径需准确",
        "visual": "只展示批准数据与口径注释，不使用客户Logo。",
        "claimIds": [
          "claim:S2-A02",
          "claim:S2-A03"
        ]
      },
      {
        "time": "70–100秒",
        "narration": "企业看AI价值，可以分三层：先看任务有没有完成，再看运行能不能管理和追溯，最后才看经营指标有没有在明确基线和归因边界下改善。",
        "subtitle": "任务价值→运行价值→经营价值",
        "visual": "三层阶梯信息图，经营价值旁标注‘以企业真实数据验证’。",
        "claimIds": [
          "EXT-001-03"
        ]
      },
      {
        "time": "100–118秒",
        "narration": "如果要开始，不妨先选一个边界清楚、结果可观察的任务，小范围验证，再决定是否扩大。产业AI的价值，最终要经得起真实业务和时间的检验。",
        "subtitle": "从小范围真实任务开始",
        "visual": "询报价、库存、供应商任务卡三选一，落到‘验证’按钮。",
        "claimIds": [
          "claim:S2-A05",
          "EXT-001-03"
        ]
      }
    ],
    "cover": "企业不缺AI工具，缺什么？",
    "cta": "您所在的企业，最想先验证哪一个真实任务？"
  },
